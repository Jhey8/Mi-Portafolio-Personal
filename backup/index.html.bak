        <section id="sobre-mi" class="py-5">

            <h1 class="fw-semibold h3 text-light text-center mt-5">Sobre Mí</h1>

            <div class="container">

                <div class="row justify-content-center g-5 text-light pt-5">

                    <div class="col-12 col-sm-6 col-md-6 col-lg-4">

                        <div class="card bg-black border text-light h-100 tarjeta">

                            <div class="card-body text-start">
                                <h5 class="card-title "><i class="bi bi-person-fill me-2"></i>¿Quién
                                    Soy?</h5>
                                <p class="card-text pt-3">Soy estudiante de Ingeniería de Sistemas e Informática, con
                                    interés en
                                    el
                                    desarrollo web.Enfocado en crear soluciones digitales modernas, funcionales y bien
                                    estructuradas.</p>
                            </div>
                        </div>

                    </div>

                    <div class="col-12 col-sm-6 col-md-6 col-lg-4">

                        <div class="card bg-black border text-light h-100 tarjeta">

                            <div class="card-body text-start">
                                <h5 class="card-title "><i class="bi bi-rocket me-2"></i>Mi Objetivo</h5>
                                <p class="card-text pt-3">Crecer como desarrollador, fortalecer mis habilidades técnicas
                                    y
                                    participar
                                    en proyectos que generen impacto, aprendiendo constantemente nuevas tecnologías y
                                    buenas
                                    prácticas.</p>
                            </div>
                        </div>

                    </div>

                    <div class="col-12 col-sm-6 col-md-6 col-lg-4">

                        <div class="card bg-black border text-light h-100 tarjeta">

                            <div class="card-body text-start">
                                <h5 class="card-title "><i class="bi bi-person-badge me-2"></i>Mi Perfil</h5>
                                <p class="card-text pt-3">Me considero una persona responsable, autodidacta y
                                    comprometida,
                                    con
                                    facilidad para adaptarme,
                                    trabajar en equipo y enfrentar nuevos retos tecnológicos.
                                </p>

                            </div>
                        </div>

                    </div>

                </div>

            </div>


        </section>

        <section id="proyectos" class="py-5">

            <h1 class="fw-semibold h3 text-light text-center mt-5">Mis Proyectos</h1>

            <p class="text-center fs-5 text-light py-3">Algunos de los proyectos en los que he trabajado</p>

            <div class="container">

                <div class="row justify-content-center g-3">

                    <div class="col-12 col-sm-6 col-md-6 col-lg-3 mt-3">

                        <div class="card p-2 tarjeta">

                            <img src="./img/imagen-pasteleria.png" class="card-img-top" alt="...">
                            <div class="card-body">
                                <h5 class="card-title">Web para Pastelería</h5>
                                <p class="card-text">Página web informativa para <br>
                                    una pastelería, donde se usó <br> HTML, CSS y JS.</p>
                                <a href="https://jhey8.github.io/Sweet_Delight/" class="btn btn-dark" target="_blank"><i
                                        class="bi bi-eye-fill me-2"></i>Ver Proyecto</a>
                            </div>
                        </div>

                    </div>

                    <div class="col-12 col-sm-6 col-md-6 col-lg-3 mt-3">

                        <div class="card p-2 tarjeta">

                            <img src="./img/SistemaVentas.png" class="card-img-top" alt="...">
                            <div class="card-body">
                                <h5 class="card-title">Sistema de Gestión Ventas</h5>
                                <p class="card-text">Sistema web para administrar<br>
                                    ventas e inventario, donde se usó <br> HTML, BOOTSTRAP, JS Y PHP.</p>
                                <a href="https://github.com/Jhey8/SistemaVentas" class="btn btn-dark" target="_blank"><i
                                        class="bi bi-eye-fill me-2"></i>Ver Proyecto</a>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </section>

        <section id="tecnologias" class="py-5">

            <h1 class="fw-semibold h3 text-light text-center mt-5">Tecnologías que Uso</h1>

            <div class="d-flex justify-content-center flex-wrap gap-4 py-5">

