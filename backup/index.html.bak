    <footer id="contactame">

        <h2 class="fw-semibold h3 text-light text-center mt-5">Contáctame</h2>

        <div class="container pt-5">

            <div class="row g-4">

                <div class="col-12 col-sm-6 col-md-6 col-lg-4">

                    <div class="border rounded-3 p-3 h-100 text-light bg-black tarjeta">

                        <form class="needs-validation" action="https://formsubmit.co/jheymybm@hotmail.com" method="POST"
                            novalidate>

                            <div class="mb-3">
                                <label class="form-label">Correo</label>
                                <input type="email" name="correo" class="form-control" required>
                                <small id="emailHelp" class="form-text text-light">Ej. ejemplo@hotmail.com</small>

                                <div class="valid-feedback">
                                    Correo válido
                                </div>
                                <div class="invalid-feedback">
                                    Ingresa un correo válido
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-light">Nombres y Apellidos</label>
                                <input type="text" name="nombres y apellidos" class="form-control" required>
                                <small id="emailHelp" class="form-text text-light">Ej. Jorge Delgado Diaz</small>

                                <div class="valid-feedback">
                                    Correcto
                                </div>
                                <div class="invalid-feedback">
                                    Este campo es obligatorio
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-light">Mensaje</label>
                                <textarea class="form-control" name="mensaje" placeholder="Ingrese su mensaje aquí..."
                                    rows="3" required minlength="10"></textarea>

                                <div class="valid-feedback">
                                    Mensaje válido
                                </div>
                                <div class="invalid-feedback">
                                    Mínimo 10 caracteres
                                </div>
                            </div>

                            <button class="btn btn-light" data-bs-toggle="modal" data-bs-target="#modalFormulario"
                                type="button">Enviar</button>

                        </form>

                    </div>
                </div>


                <div class="col-12 col-sm-6 col-md-6 col-lg-4">

                    <div class="border rounded-3 p-3 h-100 d-flex flex-column text-center bg-black tarjeta">

                        <h5 class="text-light fw-semibold">¿Tienes un proyecto en mente?</h5>
                        <p class="text-light">Estoy disponible para crear soluciones web modernas.</p>



                        <h6 class="mt-3 text-light fw-semibold">Enlaces rápidos</h6>
                        <ul class="list-unstyled">
                            <li><a href="#inicio" class="text-light text-decoration-none fw-semibold">Inicio</a></li>
                            <li><a href="#sobre-mi" class="text-light text-decoration-none fw-semibold">Sobre mí</a>
                            </li>
                            <li><a href="#proyectos" class="text-light text-decoration-none fw-semibold">Proyectos</a>
                            </li>
                            <li><a href="#tecnologias"
                                    class="text-light text-decoration-none fw-semibold">Tecnologías</a></li>
                            <li><a href="#contactame" class="text-light text-decoration-none fw-semibold">Contacto</a>
                            </li>
                        </ul>

                    </div>

                </div>


                <div class="col-12 col-sm-12 col-md-12 col-lg-4">

                    <div
                        class="d-flex flex-column justify-content-start align-items-center gap-3 flex-wrap border rounded-3 p-3 h-100 bg-black tarjeta">

                        <div>
                            <p class="text-light text-center">Redes Sociales</p>
                        </div>


                        <div>
                            <a class="btn btn-light" href="https://github.com/Jhey8" target="_blank">
                                <i class="bi bi-github"></i>
                            </a>

                            <a class="btn btn-light"
                                href="https://www.linkedin.com/in/jheymy-barboza-mondragon-423132387/" target="_blank">
                                <i class="bi bi-linkedin"></i>
                            </a>

                            <a class="btn btn-light" href="mailto:jheymybm@hotmail.com">
                                <i class="bi bi-envelope"></i>
                            </a>

                            <a class="btn btn-light" href="https://www.facebook.com/profile.php?id=61550847538088"
                                target="_blank">
                                <i class="bi bi-facebook"></i>
                            </a>

                            <a class="btn btn-light" href="https://www.instagram.com/jhey_barboza10/" target="_blank">
                                <i class="bi bi-instagram"></i>
                            </a>


                        </div>

                    </div>

                </div>

            </div>

            <div class="row">

                <div class="col-12 my-4">

                    <div class=" d-flex border rounded-3 justify-content-center align-content-center text-light p-5">
                        <p class="text-light m-0">© 2026 Jheymy Barboza. Todos los derechos reservados</p>
