        <!--modal-->
        <div class="modal" id="modalFormulario" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-center">
                        <p>¿Desea enviar el mensaje?</p>
                    </div>
                    <div class="modal-footer d-flex justify-content-center">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                        <button type="button" id="btnEnviar" class="btn btn-primary">Si Enviar</button>
                    </div>
                </div>
            </div>
        </div>

    </footer>


    <button id="btnWhatsApp"
        class="btn btn-light position-fixed  bottom-0 end-0 m-4 rounded-circle d-flex align-items-center justify-content-center"
        style="height: 60px; width: 60px;">
        <img style="height: 40px; width: 40px;" src="./img/whatsapp-logo_icon-icons.com_57054.svg" alt="">
